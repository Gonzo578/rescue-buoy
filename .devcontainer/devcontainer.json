{
  "name": "rescue-buoy (Zephyr v4.4.0 / ESP32-S3)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Run as the image's non-root user, never root. The image creates
  // `user` as uid 1000 / gid 1000.
  "remoteUser": "user",

  // Remap that user to the HOST user's uid:gid when the container is created.
  // Needed because the host user here is 1000:1001 - the uid already matches,
  // but gid 1000 does not even exist on the host, so without this every file
  // written into the bind mount would show up with a numeric group.
  // With it, everything under ~/Projects/rescue-buoy (build/ included) stays
  // owned by gonzo:gonzo and is removable without sudo.
  // This is the default on Linux, but it is too important to leave implicit.
  "updateRemoteUserUID": true,

  // Zephyr + modules live here. A named volume keeps them across container
  // rebuilds and out of git. See west.yml (import: path-prefix: deps).
  "mounts": [
    "source=rescue-buoy-west-deps,target=/workspaces/deps,type=volume",
    // Keeps bash history across container rebuilds; HISTFILE points here
    // (set in the Dockerfile's .bashrc snippet).
    "source=rescue-buoy-bash-history,target=/commandhistory,type=volume"
  ],

  // Hand the board's serial node to the container. This covers both flashing
  // (esptool over the CH343 USB-UART bridge) and the console.
  // NOTE: the board must be plugged in BEFORE "Reopen in Container", otherwise
  // docker refuses to start the container. See README.md for alternatives.
  "runArgs": [
    "--device=/dev/ttyACM0"
  ],

  "containerEnv": {
    "ZEPHYR_BASE": "/workspaces/deps/zephyr",
    // Default for the esp32 runner's --esp-device, so plain `west flash` works.
    "ESPTOOL_PORT": "/dev/ttyACM0"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      // ms-vscode.vscode-serial-monitor is deliberately NOT listed: it reads
      // host serial ports. Use picocom inside the container instead.
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "trond-snekvik.devicetree",
        "trond-snekvik.kconfig-lang",
        "marus25.cortex-debug"
      ],
      "settings": {
        // The Dockerfile sets the login shell to bash, but pin it here too so
        // VS Code never falls back to /bin/sh (dash), which has no history.
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
        "files.associations": {
          "*.overlay": "dts",
          "*.dtsi": "dts",
          "prj.conf": "properties",
          "*.conf": "properties"
        }
      }
    }
  }
}
